# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your actual AWS resource IDs

environment = "dev"
aws_region  = "us-east-1"

# Network configuration
# Run: aws ec2 describe-vpcs --profile srini-sandbox
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# Run: aws ec2 describe-subnets --filters "Name=vpc-id,Values=YOUR_VPC_ID" --profile srini-sandbox
private_subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]

# Run: aws ec2 describe-security-groups --filters "Name=vpc-id,Values=YOUR_VPC_ID" --profile srini-sandbox
app_security_group_ids = ["sg-xxxxxxxxxxxxxxxxx"]

# Database configuration
postgres_version  = "15.4"
db_instance_class = "db.t3.micro"
allocated_storage = 20
db_name           = "myapp"
db_username       = "postgres"
# Note: Password is auto-generated by Terraform using random_password resource

# Backup configuration
backup_retention_period = 7
skip_final_snapshot     = false  # Set to true for dev to avoid final snapshot on destroy
